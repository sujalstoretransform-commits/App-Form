{
  "version": 2,
  "builds": [
    {
      "src": "web/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "web/frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/public/(.*)",
      "dest": "web/index.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "web/index.js"
    },
    {
      "src": "/proxy/(.*)",
      "dest": "web/index.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "web/frontend/assets/$1"
    },
    {
      "src": "/(.*\\..*)",
      "dest": "web/frontend/$1"
    },
    {
      "src": "/(.*)",
      "dest": "web/frontend/index.html"
    }
  ],
  "headers": [
    {
      "source": "/embed.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        }
      ]
    }
  ]
}